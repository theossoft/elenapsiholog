generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

model Setting {
  id               String @id @default("default")
  price            Int    @default(4000)
  durationMin      Int    @default(55)
  slotStepMin      Int    @default(60)
  meetLink         String @default("")
  successText      String @default("Заявка принята. Я напишу в MAX или Telegram, чтобы подтвердить время.")
  pendingHoldHours Int    @default(12)
  horizonDays      Int    @default(21)
}

model WeeklyAvailability {
  id        String @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
}

model AvailabilityException {
  id     String  @id @default(cuid())
  date   String
  kind   String
  time   String?
}

model Booking {
  id         String   @id @default(cuid())
  slotStart  DateTime @unique
  slotEnd    DateTime
  name       String
  phone      String
  telegram   String   @default("")
  email      String   @default("")
  note       String   @default("")
  status     String   @default("pending")
  meetLink   String   @default("")
  consentAt  DateTime
  remindedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
