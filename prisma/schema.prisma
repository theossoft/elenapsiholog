generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

model Setting {
  id               String @id @default("default")
  price            Int    @default(4000)
  durationMin      Int    @default(55)
  slotStepMin      Int    @default(60)
  meetLink         String @default("")
  successText      String @default("Заявка принята. Откройте бота записи, чтобы видеть время и получить напоминание. Я напишу в MAX или Telegram, чтобы подтвердить встречу.")
  successTitle     String @default("Готово")
  successMaxCta    String @default("Написать в MAX")
  successTelegramCta String @default("Написать в Telegram")
  pendingHoldHours Int    @default(12)
  horizonDays      Int    @default(21)
  heroEyebrow      String @default("Гештальт-терапия · КПТ · онлайн")
  heroHeadline     String @default("Понять себя и найти опору — в живом диалоге, а не в советах с потолка")
  heroLead         String @default("Я Елена Иванова, психолог и гештальт-терапевт. Вместе исследуем чувства и находим конкретные шаги, которые можно взять в жизнь.")
  heroStat1Value   String @default("13 лет")
  heroStat1Label   String @default("практики")
  heroStat2Value   String @default("800+")
  heroStat2Label   String @default("сессий на Alter")
  heroStat3Value   String @default("55 мин")
  heroStat3Label   String @default("онлайн-встреча")
  topicsTitle      String @default("Можно прийти без готового «диагноза» — достаточно того, что сейчас тяжело")
  howTitle         String @default("Онлайн-сессия без лишней суеты")
  aboutTitle       String @default("Елена Иванова — психолог, гештальт-терапевт")
  aboutP1          String @default("Больше 13 лет помогаю взрослым, подросткам и семьям лучше понимать чувства, выстраивать отношения и опираться на себя. В работе соединяю глубину гештальта с ясными техниками КПТ: не только «поговорить», но и найти, что можно изменить.")
  aboutP2          String @default("Верю, что осознание своих эмоций и мыслей — первый шаг. Дальше идём вместе, в диалоге, в темпе, который вам подходит.")
  teensLead        String @default("Работаю с детьми и подростками: страхи, общение, семейные кризисы. Иногда встреча нужна родителю, иногда — подростку. Это обсуждаем заранее.")
  priceLead        String @default("Оплата — переводом после того, как я подтвержу время. На сайте ничего списывать не нужно: сначала договариваемся, потом встречаемся.")
  bookingLead      String @default("Слот бронируется после заявки. Достаточно email для чека — имя и телефон можно добавить в кабинете. Я подтверждаю встречу в мессенджере и присылаю способ оплаты. Часовой пояс — Москва.")
}

model WeeklyAvailability {
  id        String @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
}

model AvailabilityException {
  id     String  @id @default(cuid())
  date   String
  kind   String
  time   String?
}

model Client {
  id             String    @id @default(cuid())
  email          String?   @unique
  phone          String    @default("")
  name           String    @default("")
  telegram       String    @default("")
  telegramChatId String    @default("")
  maxUserId      String    @default("")
  vkId           String?   @unique
  note           String    @default("")
  emailVerifiedAt DateTime?
  consentAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([phone])
  @@index([telegramChatId])
  @@index([maxUserId])
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Booking {
  id             String    @id @default(cuid())
  slotStart      DateTime  @unique
  slotEnd        DateTime
  name           String    @default("")
  phone          String    @default("")
  telegram       String    @default("")
  telegramChatId String    @default("")
  linkToken      String?   @unique
  email          String    @default("")
  note           String    @default("")
  status         String    @default("pending")
  meetLink       String    @default("")
  amountRub      Int       @default(0)
  paidAt         DateTime?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  consentAt      DateTime
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@index([email])
}

model TelegramClient {
  chatId    String   @id
  name      String
  phone     String
  username  String   @default("")
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramSession {
  chatId    String   @id
  step      String
  payload   String   @default("")
  updatedAt DateTime @updatedAt
}
